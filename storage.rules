rules_version = '2';

// Regole di Firebase Storage per Gestione Aule DBALEX.
//
// Percorso "manuali/**": ospita i due manuali amministrativi (IT/AR)
// mostrati come download nella schermata di accesso dell'app.
// - Lettura: pubblica (chiunque abbia il link scarica il file, senza
//   bisogno di un account — il manuale è materiale informativo, non dati
//   riservati).
// - Scrittura: solo utenti autenticati il cui documento Firestore
//   users/{uid} ha role == "gestore" — stesso livello di accesso richiesto
//   in app da puoGestireManuali() in src/app/index.tsx.
service firebase.storage {
  match /b/{bucket}/o {
    match /manuali/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'gestore';
    }

    // Tutto il resto del bucket resta chiuso di default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
